GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional overrides:
# TELECOM_STUDIO_GROQ_MODEL=openai/gpt-oss-120b
# TELECOM_STUDIO_GROQ_BASE_URL=https://api.groq.com/openai/v1
# TELECOM_STUDIO_GROQ_EXTRACTION_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_EXTRACTION_TIMEOUT_S=30
# TELECOM_STUDIO_GROQ_EXTRACTION_MAX_COMPLETION_TOKENS=4096
# TELECOM_STUDIO_GROQ_PLANNING_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_PLANNING_TIMEOUT_S=15
# TELECOM_STUDIO_GROQ_PLANNING_MAX_COMPLETION_TOKENS=2048
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_TIMEOUT_S=15
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_MAX_COMPLETION_TOKENS=1024
# TELECOM_STUDIO_ENABLE_GROQ_GEOMETRY_PROGRAM=true
# TELECOM_STUDIO_GROQ_GEOMETRY_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_GEOMETRY_TIMEOUT_S=90
# TELECOM_STUDIO_GROQ_GEOMETRY_MAX_COMPLETION_TOKENS=8192
# TELECOM_STUDIO_QDRANT_URL=http://127.0.0.1:6333
# TELECOM_STUDIO_BLENDER_BINARY=/Applications/Blender 4.5 LTS.app/Contents/MacOS/Blender
# TELECOM_STUDIO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Embedding strategy:
# - "nvidia"                : NVIDIA multilingual retrieval API (recommended, default)
# - "deterministic"         : hash fallback for tests / emergency only
# TELECOM_STUDIO_EMBEDDING_PROVIDER=nvidia
# TELECOM_STUDIO_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# TELECOM_STUDIO_EMBEDDING_DIMENSIONS=1024
# TELECOM_STUDIO_EMBEDDING_STRICT_QUALITY=0
# In "auto" mode, set strict quality to 1 to reject deterministic bootstrap fallback.

# Blender fallback policy:
# - 0 (default) : require real Blender output; fallback artifacts fail QA
# - 1           : allow fallback artifacts for demo/testing only
# TELECOM_STUDIO_ALLOW_BLENDER_FALLBACK=0

# Docker Compose runtime (infra/docker-compose.yml):
# The Compose file supplies the container paths below. Keep these commented for
# native macOS runs; uncomment them only when overriding Compose deliberately.
# TELECOM_STUDIO_PROJECT_ROOT=/app
# TELECOM_STUDIO_ASSET_MANIFESTS_DIR=/app/assets/manifests
# TELECOM_STUDIO_ASSET_LIBRARY_PATH=/app/assets/library
# TELECOM_STUDIO_SQLITE_PATH=/var/lib/telecom/sqlite/telecom_studio.db
# TELECOM_STUDIO_OUTPUTS_DIR=/var/lib/telecom/outputs
# TELECOM_STUDIO_QDRANT_URL=http://qdrant:6333
# TELECOM_STUDIO_QDRANT_PATH=/var/lib/telecom/sqlite/qdrant-client-state
# TELECOM_STUDIO_BLENDER_BINARY=/opt/blender/blender
# TELECOM_STUDIO_BLENDER_EEVEE_RENDER_SAMPLES=8
# TELECOM_STUDIO_BLENDER_TIMEOUT_S=600
# TELECOM_STUDIO_MAX_CONCURRENT_WORKFLOWS=1
# TELECOM_STUDIO_MAX_PENDING_WORKFLOWS=2
