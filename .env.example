GROQ_API_KEY=
# Optional additional accounts, comma or semicolon separated. Keep secrets only
# in the ignored local .env; the scalar key remains the primary compatibility slot.
# TELECOM_STUDIO_GROQ_API_KEYS=
NVIDIA_API_KEY=
# Optional overrides:
# TELECOM_STUDIO_GROQ_MODEL=openai/gpt-oss-120b
# TELECOM_STUDIO_GROQ_TEXT_MODEL=openai/gpt-oss-120b
# TELECOM_STUDIO_GROQ_BASE_URL=https://api.groq.com/openai/v1
# TELECOM_STUDIO_GROQ_EXTRACTION_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_EXTRACTION_TIMEOUT_S=30
# TELECOM_STUDIO_GROQ_EXTRACTION_MAX_COMPLETION_TOKENS=4096
# TELECOM_STUDIO_GROQ_PLANNING_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_PLANNING_TIMEOUT_S=15
# TELECOM_STUDIO_GROQ_PLANNING_MAX_COMPLETION_TOKENS=2048
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_TIMEOUT_S=15
# TELECOM_STUDIO_GROQ_ASSET_SELECTION_MAX_COMPLETION_TOKENS=1024
# TELECOM_STUDIO_ENABLE_GROQ_GEOMETRY_PROGRAM=true
# TELECOM_STUDIO_GROQ_GEOMETRY_REASONING_EFFORT=medium
# TELECOM_STUDIO_GROQ_GEOMETRY_TIMEOUT_S=90
# TELECOM_STUDIO_GROQ_GEOMETRY_MAX_COMPLETION_TOKENS=8192
# Remote multimodal processing is always opt-in per workflow/project and is
# disabled by default. It reuses GROQ_API_KEY; do not add a key to Git.
# TELECOM_STUDIO_ENABLE_GROQ_VISION=false
# TELECOM_STUDIO_GROQ_VISION_MODEL=qwen/qwen3.6-27b
# TELECOM_STUDIO_GROQ_VISION_TIMEOUT_S=45
# TELECOM_STUDIO_GROQ_VISION_MAX_COMPLETION_TOKENS=2048
# TELECOM_STUDIO_GROQ_VISION_MAX_IMAGES=3
# TELECOM_STUDIO_GROQ_VISION_MAX_IMAGE_BYTES=20000000
# TELECOM_STUDIO_GROQ_VISION_MAX_PIXELS=16000000
# TELECOM_STUDIO_GROQ_VISION_MAX_EDGE_PX=4096
# TELECOM_STUDIO_GROQ_TRANSPORT_MAX_RETRIES=2
# A rate-limited credential is cooled without sleeping a workflow thread.
# TELECOM_STUDIO_GROQ_RETRY_AFTER_CAP_S=3600
# TELECOM_STUDIO_GROQ_RATE_LIMIT_DEFAULT_COOLDOWN_S=60
# TELECOM_STUDIO_GROQ_MAX_IN_FLIGHT_PER_CREDENTIAL=2
# TELECOM_STUDIO_GROQ_POOL_ACQUIRE_TIMEOUT_S=10
# TELECOM_STUDIO_GROQ_CIRCUIT_FAILURE_THRESHOLD=3
# TELECOM_STUDIO_GROQ_CIRCUIT_RESET_S=30
# TELECOM_STUDIO_QDRANT_URL=http://127.0.0.1:6333
# TELECOM_STUDIO_BLENDER_BINARY=/Applications/Blender 4.5 LTS.app/Contents/MacOS/Blender
# TELECOM_STUDIO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# TELECOM_STUDIO_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# Local authentication is enabled by default. The first owner chooses a password
# in the browser; never place that password in this file.
# TELECOM_STUDIO_AUTH_ENABLED=true
# TELECOM_STUDIO_AUTH_SESSION_TTL_SECONDS=28800
# Use a distinct name when two isolated studio instances share the same host.
# TELECOM_STUDIO_AUTH_COOKIE_NAME=telecom_studio_session

# Embedding strategy:
# - "nvidia"                : NVIDIA multilingual retrieval API (recommended, default)
# - "deterministic"         : hash fallback for tests / emergency only
# TELECOM_STUDIO_EMBEDDING_PROVIDER=nvidia
# TELECOM_STUDIO_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# TELECOM_STUDIO_EMBEDDING_DIMENSIONS=2048
# TELECOM_STUDIO_EMBEDDING_TIMEOUT_S=30
# TELECOM_STUDIO_EMBEDDING_STRICT_QUALITY=0
# The hosted NVIDIA text rerankers were unavailable at the last live check.
# Keep passthrough explicit until a replacement is verified; the API reports it.
# TELECOM_STUDIO_RERANKER_PROVIDER=passthrough
# In "auto" mode, set strict quality to 1 to reject deterministic bootstrap fallback.

# Blender fallback policy:
# - 0 (default) : require real Blender output; fallback artifacts fail QA
# - 1           : allow fallback artifacts for demo/testing only
# TELECOM_STUDIO_ALLOW_BLENDER_FALLBACK=0

# Docker Compose runtime (infra/docker-compose.yml):
# The Compose file supplies the container paths below. Keep these commented for
# native macOS runs; uncomment them only when overriding Compose deliberately.
# TELECOM_STUDIO_PROJECT_ROOT=/app
# TELECOM_STUDIO_ASSET_MANIFESTS_DIR=/app/assets/manifests
# TELECOM_STUDIO_ASSET_LIBRARY_PATH=/app/assets/library
# TELECOM_STUDIO_SQLITE_PATH=/var/lib/telecom/sqlite/telecom_studio.db
# TELECOM_STUDIO_OUTPUTS_DIR=/var/lib/telecom/outputs
# TELECOM_STUDIO_QDRANT_URL=http://qdrant:6333
# TELECOM_STUDIO_QDRANT_PATH=/var/lib/telecom/sqlite/qdrant-client-state
# TELECOM_STUDIO_BLENDER_BINARY=/opt/blender/blender
# TELECOM_STUDIO_BLENDER_EEVEE_RENDER_SAMPLES=8
# TELECOM_STUDIO_BLENDER_TIMEOUT_S=600
# TELECOM_STUDIO_MAX_CONCURRENT_WORKFLOWS=1
# TELECOM_STUDIO_MAX_PENDING_WORKFLOWS=2

# Optional Docker outbound proxy. Leave empty when direct HTTPS works.
# Use the proxy reported by your Docker environment, not a vendor IP address.
# TELECOM_STUDIO_HTTP_PROXY=
# TELECOM_STUDIO_HTTPS_PROXY=
# TELECOM_STUDIO_NO_PROXY=localhost,127.0.0.1,qdrant,api,frontend

# Optional host ports when a native studio already occupies 5173/8000.
# TELECOM_STUDIO_FRONTEND_PORT=5173
# TELECOM_STUDIO_API_PORT=8000
