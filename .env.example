GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional overrides:
# TELECOM_STUDIO_GROQ_MODEL=openai/gpt-oss-120b
# TELECOM_STUDIO_QDRANT_URL=http://127.0.0.1:6333
# TELECOM_STUDIO_BLENDER_BINARY=/Applications/Blender.app/Contents/MacOS/Blender

# Embedding strategy:
# - "nvidia"                : NVIDIA API for baai/bge-m3 (recommended, default)
# - "sentence-transformers" : local BAAI/bge-m3 model (offline fallback)
# - "deterministic"         : hash fallback for tests / emergency only
# TELECOM_STUDIO_EMBEDDING_PROVIDER=nvidia
# TELECOM_STUDIO_EMBEDDING_MODEL=baai/bge-m3
# TELECOM_STUDIO_EMBEDDING_STRICT_QUALITY=0
